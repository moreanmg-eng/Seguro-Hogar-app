# Esta es una PLANTILLA. En Streamlit Community Cloud NO subas este
# archivo con tus datos reales — en vez de eso, pegas este mismo
# contenido (ya con tus datos reales) en la sección "Secrets" cuando
# despliegues tu app desde share.streamlit.io.
#
# Si vas a correr la app en tu propia computadora, puedes copiar este
# archivo a .streamlit/secrets.toml y llenarlo ahí (también funciona
# como alternativa al archivo .env).

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "tu_correo@gmail.com"
SMTP_PASSWORD = "tu_contrasena_de_aplicacion"
FROM_EMAIL = "tu_correo@gmail.com"
ADMIN_EMAIL = "morean.mg@gmail.com"
ADMIN_PASSWORD = "elige-una-clave-segura"

# --- Respaldo automático en Google Sheets (opcional) ---
# Ver la sección "Respaldo automático en Google Sheets" del README
# para los pasos completos. El ID es la parte de la URL de tu hoja
# entre "/d/" y "/edit": https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID = "el_id_de_tu_hoja_de_calculo"

# Pega aquí TODO el contenido del .json que descargaste de Google Cloud
# al crear la cuenta de servicio (cada campo del json es una línea aquí).
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tu-cuenta-de-servicio@tu-proyecto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
